projection;
strict ( 2 );
use draft;
use side effects;

define behavior for Zc_Febh //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action processfiles;

  use event bgPFFinished;

  side effects
  {
    event bgPFFinished affects field BGPFStatus, field BGPFStatusCriticality, field bgpfstatusdescription, field status, field StatusDescription, field CriticalityStatus, field message;
  }

  use association _FEBP { create; with draft; }
}

define behavior for ZC_FEBP //alias <alias_name>
{
  use update;
  use delete;

  use association _FEBH { with draft; }
}